        . " rect=" . node.x . "," . node.y . "," . node.w . "," . node.h)
    u := node.r1 ? D2ReadU32(h,node.r1+0x74) : 0, seen := {}, n := 0, shown := 0
    while (u && n<256 && shown<12 && !seen.HasKey(u))
    {
