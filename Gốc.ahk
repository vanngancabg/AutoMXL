FarmPortalSelectV725(h,ByRef pb,pid,r)
{
    global farmControlOwnerV186
    session := FarmPortalSessionV725(pid)
    level := CoordLevelV14(h,NumGet(pb,0x1C,"UInt"))
    if (!FarmRevivePortalSourceV746(level))
    {
