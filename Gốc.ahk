                if (itemV738.cls=1204 && itemV738.q=2 && itemV738.loc=0 && itemV738.owner=ctx.inv)
                    cubeV738 := itemV738
                if (itemV738.cls!=ticketClassV289 || itemV738.q!=2 || modeV738=3 || modeV738=5)
                    continue
