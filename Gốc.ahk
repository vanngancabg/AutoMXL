HealScanRootsV4(h, inv)
{
    roots := [], seen := {}, errors := 0
    for _, off in [0x0C,0x10]
    {
        if (!PickupReadU32V4(h,inv+off,u))
        {
            errors++
            continue
        }
        if (u && !seen.HasKey(u))
        {
            seen[u] := true
            roots.Push(u)
        }
    }
    return {roots:roots,errors:errors}
}

