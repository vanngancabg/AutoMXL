        MonsterStuckUidSkipV711(oldUid,level,pid)
        PortalLogWriteV66("COMBAT_STUCK_SWITCH old_uid=" . oldUid . " new_uid=" . near.uid
            . " scope=UID dist_sq=" . Round(current.dist,1) . " half_bk_sq=" . Round(bkHalfSq,1))
