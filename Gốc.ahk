MonsterSkipDistanceChangedV752:
GuiControlGet, skipInputV752, 1:, MonsterSkipDistanceInputV752
if (RegExMatch(skipInputV752,"^\d+$") && skipInputV752<=200)
    monsterSkipDistanceV752 := skipInputV752+0
