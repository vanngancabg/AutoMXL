            }
    if (!IsObject(reagent) && resumeStep5)
        for _,a in SigCubeItemsV147(ctx)
            if (a.cls=reagentClass && a.q=2)
                reagent := a
    if (!IsObject(reagent))
    {
        for _,a in SigCubeItemsV147(ctx)
