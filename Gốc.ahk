healMPNeed := (healVitals.mana>=0 && healVitals.mana<=manaThreshold)
HealTrace("HP_GATE pid=" . healVitals.pid . " value=" . healVitals.hp
    . " threshold=" . potHPThreshold . " enabled=" . healHPEnabled
