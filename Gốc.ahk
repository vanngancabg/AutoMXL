            gems := Ticket130PrepareGemsV266(ctx,cube,target*materialPerTicket)
            phase := soulMode ? "MOVE_PARAGON_HAMMER" : "MOVE_ZAKARUM_EAR"
            Ticket130ReserveV265(ctx,reagent)
            SigToCubeV147(ctx,reagent,cube,true)
            materialIndex := 0
            Loop, %target%
            {
                SigCheckV147(ctx)
