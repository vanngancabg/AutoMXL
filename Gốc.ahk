healMPEnabled := manaOn || invManaOn || cubeManaOn
healHPWait := Max(0, potCooldown - (A_TickCount-potLastDrink), potNextDrinkAtV730-A_TickCount)
healMPWait := Max(0, manaCooldown - (A_TickCount-manaLastDrink))
