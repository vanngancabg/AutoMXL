        if (level!=1 && level!=40 && level!=75 && level!=103 && level!=109)
            SigFailV147("Tạo vé khi nhân vật ở thành")
        if (IsObject(entryV293))
        {
            phase := "CHECK_EXISTING_TICKET"
            existingV738 := false,cubeV738 := false
