HealTrace("MANA_GATE pid=" . healVitals.pid . " value=" . healVitals.mana
    . " threshold=" . manaThreshold . " enabled=" . healMPEnabled
    . " need=" . healMPNeed . " cooldown_left_ms=" . healMPWait . " read=" . healVitals.reason, "mp_gate")
