                return true
            }
            rejected++
            SigLogV147("TICKET_SLOT_REJECTED uid=" . item.uid . " xy=" . x . "," . y)
        }
    }
    SigFailV147("Không còn ô trống phù hợp để đặt vật; UID=" . item.uid . "; rejected=" . rejected)
}

