        }
        pickupOptCacheV12[job.key] := info
        DebugTraceWrite("pickup","D2MX_ITEM uid=" . job.uid . " class=" . job.cls . " ok=" . info.ok . " name=" . StrReplace(name,"`n"," | ") . " options=" . StrReplace(stats,"`n"," | "))
