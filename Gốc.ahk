                    existingV738 := itemV738
                else if (itemV738.loc=3 && (!IsObject(existingV738) || existingV738.loc!=0))
                    existingV738 := itemV738
            }
            if (IsObject(existingV738))
            {
                if (existingV738.loc=3)
                {
                    if (!IsObject(cubeV738))
