        routeSnapshotV80 := coordRouteV16
        if (!IsObject(routeSnapshotV80) || !IsObject(routeSnapshotV80.escapeV84)
            || (routeSnapshotV80.escapeV84.reason!="WALK_NO_PROGRESS"
                && routeSnapshotV80.escapeV84.reason!="COMBAT_NO_PROGRESS"))
