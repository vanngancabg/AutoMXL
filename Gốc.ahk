                else if (dist<=Max(1,monsterRadiusV48)**2 && !MonsterClassExcludedV11(cls,h,u)
                    && !MonsterRetryExcludedV44(uid,x,y,154,pid)
                    && (!IsObject(result.near) || dist<result.near.dist))
